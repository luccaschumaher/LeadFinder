# Copie para .env.local e preencha. O .env.local não vai para o Git.

# Supabase (Dashboard › Project Settings › API)
# A chave publicável é pública por design: a segurança vem das regras (RLS) no banco.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Liga a IA real (Gerador e WaveIA) depois de publicar a edge function lf-ai com o segredo.
# Não é uma chave: só diz ao app para chamar a função. Padrão: IA em modo demonstração.
# VITE_DEMO_AI=false

# Liga a busca real de empresas depois de publicar a edge function lf-places-search.
# VITE_DEMO_SEARCH=false

# CAPTCHA (Cloudflare Turnstile): a "Site Key" é pública. A "Secret Key" vai SÓ no Supabase
# (Authentication › Attack Protection), nunca aqui.
# VITE_TURNSTILE_SITE_KEY=

# ATENÇÃO: nunca coloque chaves de IA ou de APIs em variáveis VITE_ — tudo que começa com
# VITE_ vai embutido no JavaScript do site e fica visível para qualquer visitante.

# As chaves abaixo são SECRETAS e ficam só nos "Secrets" das Edge Functions do Supabase:
# GEMINI_API_KEY=                  (IA pelo Google AI Studio; recomendado plano pago para produção)
# GOOGLE_VERTEX_SERVICE_ACCOUNT=   (alternativa: Claude pelo Google Cloud, pós-pago)
# ANTHROPIC_API_KEY=               (alternativa: Claude pela Anthropic, pré-pago)
# SERPER_API_KEY=                  (busca real de empresas pelo Serper.dev — recomendado)
# GOOGLE_PLACES_API_KEY=           (alternativa: Google Places oficial)
