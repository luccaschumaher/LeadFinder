# Copie para .env.local e preencha. O .env.local não vai para o Git.

# Supabase (Dashboard › Project Settings › API)
# A chave publicável é pública por design: a segurança vem das regras (RLS) no banco.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# As chaves abaixo são SECRETAS e nunca vão para o frontend.
# Elas ficam nos "Secrets" das Edge Functions do Supabase (próximas etapas):
# GOOGLE_PLACES_API_KEY=
# GOOGLE_VERTEX_SERVICE_ACCOUNT=   (JSON da conta de serviço; IA pós-paga pelo Google Cloud)
# ANTHROPIC_API_KEY=               (alternativa: IA pela Anthropic, pré-pago)
# CAKTO_WEBHOOK_SECRET=
